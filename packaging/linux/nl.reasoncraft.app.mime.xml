<?xml version="1.0" encoding="UTF-8"?>
<!-- The MIME type of ReasonCraft maps, for shared-mime-info. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-reasoncraft">
    <comment>ReasonCraft map</comment>
    <comment xml:lang="nl">ReasonCraft-kaart</comment>
    <!-- The app's icon (installed in hicolor under apps/); without it a file manager falls back
         to the parent type's, a zip archive. -->
    <icon name="nl.reasoncraft.app"/>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.rcraft"/>
  </mime-type>
</mime-info>
