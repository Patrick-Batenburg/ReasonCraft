[Desktop Entry]
Type=Application
Name=ReasonCraft
GenericName=Argument Maps
GenericName[nl]=Argumentkaarten
Comment=Map out arguments: claims, reasons and objections
Comment[nl]=Breng argumenten in kaart: beweringen, redenen en bezwaren
Exec=reasoncraft %F
TryExec=reasoncraft
Icon=io.github.Patrick_Batenburg.ReasonCraft
Terminal=false
StartupNotify=true
StartupWMClass=io.github.Patrick_Batenburg.ReasonCraft
Categories=Education;Office;
Keywords=argument;map;reasoning;claim;objection;critical thinking;debate;
Keywords[nl]=argument;kaart;redeneren;bewering;stelling;bezwaar;kritisch denken;debat;
MimeType=application/x-reasoncraft;
